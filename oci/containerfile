FROM node:lts-bookworm-slim

ARG PI_VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && PI_PACKAGE=@earendil-works/pi-coding-agent \
    && if [ -n "$PI_VERSION" ]; then PI_PACKAGE="${PI_PACKAGE}@${PI_VERSION}"; fi \
    && npm install --global --ignore-scripts "$PI_PACKAGE" \
    && npm cache clean --force \
    && mkdir -p /home/node/.pi/agent \
    && chown -R node:node /home/node

ENV HOME=/home/node \
    PI_CODING_AGENT_DIR=/home/node/.pi/agent

USER node
WORKDIR /workspace
ENTRYPOINT ["pi"]
