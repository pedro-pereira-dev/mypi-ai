FROM node:lts-bookworm-slim

ARG PI_VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        git \
        ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && PI_PACKAGE=@earendil-works/pi-coding-agent \
    && if [ -n "$PI_VERSION" ]; then PI_PACKAGE="${PI_PACKAGE}@${PI_VERSION}"; fi \
    && npm install --global --ignore-scripts --prefix /opt/pi "$PI_PACKAGE" \
    && npm cache clean --force \
    && (userdel --remove node 2>/dev/null || true) \
    && (groupdel node 2>/dev/null || true) \
    && groupadd --gid 1000 pi \
    && useradd --uid 1000 --gid pi --create-home --shell /bin/bash pi \
    && mkdir -p /workspace /home/pi/.pi/agent \
    && chown -R pi:pi /workspace /home/pi

ENV HOME=/home/pi \
    PATH=/opt/pi/bin:$PATH \
    NPM_CONFIG_CACHE=/home/pi/.pi/agent/cache/npm \
    PI_CODING_AGENT_DIR=/home/pi/.pi/agent

USER pi
WORKDIR /workspace
ENTRYPOINT ["pi"]
