#!/bin/sh

set -eu

die() {
    printf '%s\n' "mypi: $*" >&2
    exit 1
}

absolute_dir() {
    [ -d "$1" ] || die "directory does not exist: $1"
    (CDPATH= cd -- "$1" && pwd -P)
}

command -v podman >/dev/null 2>&1 || die "Podman is not installed"
podman info >/dev/null 2>&1 || die "Podman is not running or is not accessible"

IMAGE=${MYPI_IMAGE:-mypi:local}
PROJECT_DIR=$(absolute_dir "${MYPI_PROJECT:-$(pwd)}")
CONFIG_DIR=${MYPI_CONFIG_DIR:-$HOME/.config/mypi}
CPUS=${MYPI_CPUS:-4}
MEMORY=${MYPI_MEMORY:-4g}
TMP_SIZE=${MYPI_TMP_SIZE:-512m}
INTERACTIVE=${MYPI_INTERACTIVE:-1}
HOST_UID=$(id -u)
HOST_GID=$(id -g)

[ "$HOST_UID" -ne 0 ] || die "refusing to run Pi with host UID 0"

case $CONFIG_DIR in
    /*) ;;
    *) die "MYPI_CONFIG_DIR must be an absolute path" ;;
esac

HOME_DIR=$(absolute_dir "$HOME")
[ "$CONFIG_DIR" != / ] || die "refusing to use / as the configuration directory"
[ "$CONFIG_DIR" != "$HOME_DIR" ] || die "refusing to mount the whole home directory as configuration"
[ "$CONFIG_DIR" != "$PROJECT_DIR" ] || die "configuration directory must differ from the project directory"

if [ ! -d "$CONFIG_DIR" ]; then
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR"
fi
CONFIG_DIR=$(absolute_dir "$CONFIG_DIR")
[ "$CONFIG_DIR" != / ] || die "refusing to use / as the configuration directory"
[ "$CONFIG_DIR" != "$HOME_DIR" ] || die "refusing to mount the whole home directory as configuration"
[ "$CONFIG_DIR" != "$PROJECT_DIR" ] || die "configuration directory must differ from the project directory"

printf 'Runtime: podman\nImage: %s\nProject: %s\nConfig: %s\n' \
    "$IMAGE" "$PROJECT_DIR" "$CONFIG_DIR"

case $INTERACTIVE in
    1)
        exec podman run --rm --interactive --tty \
            --user "$HOST_UID:$HOST_GID" \
            --read-only \
            --cap-drop ALL \
            --security-opt no-new-privileges \
            --cpus "$CPUS" \
            --memory "$MEMORY" \
            --tmpfs "/tmp:rw,nosuid,nodev,size=$TMP_SIZE,mode=1777" \
            --mount "type=bind,source=$PROJECT_DIR,target=/workspace" \
            --mount "type=bind,source=$CONFIG_DIR,target=/home/pi/.pi/agent" \
            --workdir /workspace \
            "$IMAGE" "$@"
        ;;
    0)
        exec podman run --rm \
            --user "$HOST_UID:$HOST_GID" \
            --read-only \
            --cap-drop ALL \
            --security-opt no-new-privileges \
            --cpus "$CPUS" \
            --memory "$MEMORY" \
            --tmpfs "/tmp:rw,nosuid,nodev,size=$TMP_SIZE,mode=1777" \
            --mount "type=bind,source=$PROJECT_DIR,target=/workspace" \
            --mount "type=bind,source=$CONFIG_DIR,target=/home/pi/.pi/agent" \
            --workdir /workspace \
            "$IMAGE" "$@"
        ;;
    *) die "MYPI_INTERACTIVE must be 0 or 1" ;;
esac
