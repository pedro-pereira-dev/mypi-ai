#!/bin/sh

set -eu

TEST_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
SCRIPT_DIR=$(CDPATH= cd -- "$TEST_DIR/../scripts" && pwd -P)
# shellcheck source=SCRIPTDIR/../scripts/common.sh
. "$SCRIPT_DIR/common.sh"

require_podman

IMAGE=${MYPI_IMAGE:-mypi:test}
TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/mypi-run.XXXXXX")
PROJECT_DIR=$TMP_ROOT/project
CONFIG_DIR=$TMP_ROOT/config

cleanup() {
    rm -rf "$TMP_ROOT"
}
trap cleanup EXIT HUP INT TERM

mkdir -p "$PROJECT_DIR"
podman image exists "$IMAGE" || die "image $IMAGE does not exist; run oci/tests/test-build first"
EXPECTED_VERSION=$(podman run --rm "$IMAGE" --version)

OUTPUT=$(
    MYPI_IMAGE=$IMAGE \
    MYPI_PROJECT=$PROJECT_DIR \
    MYPI_CONFIG_DIR=$CONFIG_DIR \
    MYPI_INTERACTIVE=0 \
    "$SCRIPT_DIR/mypi" --version
)

case $OUTPUT in
    *"Runtime: podman"*"$EXPECTED_VERSION"*) ;;
    *) die "mypi did not run Pi $EXPECTED_VERSION" ;;
esac

[ -d "$CONFIG_DIR" ] || die "mypi did not create the host configuration directory"
[ "$(stat -f '%Lp' "$CONFIG_DIR" 2>/dev/null || stat -c '%a' "$CONFIG_DIR")" = 700 ] \
    || die "configuration directory permissions are not 700"

printf 'mypi run test passed for %s\n' "$IMAGE"
